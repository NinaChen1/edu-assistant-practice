# ============================================
# DeepSeek API 配置示例（只含变量名，不含真实密钥）
#
# 使用方法：
#   1. 把本文件复制一份，重命名为 .env
#   2. 在 .env 里填入你自己的真实密钥
#   3. .env 已被 .gitignore 排除，永远不会提交到 GitHub
# ============================================

# 必填：在 DeepSeek 开放平台申请的 API Key（形如 sk-xxxx）
DEEPSEEK_API_KEY=

# 选填：接口地址，默认官方地址，一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 选填：模型名称，deepseek-chat 是通用对话模型
DEEPSEEK_MODEL=deepseek-chat
